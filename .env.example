# Environment Variables Example
# Copy this file to .env and update the values as needed

# API Base URL - Update this with your backend API URL
NEXT_PUBLIC_API_BASE_URL=https://coupon-app-backend.vercel.app

# Production Domain Configuration
# Update this with your production domain URL
NEXT_PUBLIC_SITE_URL=https://www.pennyscroll.com

# Image Configuration
NEXT_PUBLIC_IMAGE_DOMAIN=coupon-app-image.s3.us-east-1.amazonaws.com

# API Timeout (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=coupon-app-image
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_ACCESS_KEY_ID=your-aws-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-aws-secret-access-key